FROM python:3.13-slim
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg fonts-dejavu-core && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY editor/drive-requirements.txt /app/editor/drive-requirements.txt
RUN pip install --no-cache-dir "Pillow>=12,<13" -r editor/drive-requirements.txt
COPY editor /app/editor
CMD ["python", "-m", "editor.drive_worker"]
